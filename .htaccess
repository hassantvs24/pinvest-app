# Laravel application lives in public/. Preferred server setup is to point
# the vhost DocumentRoot at public/ — this file is the stopgap for hosts
# whose DocumentRoot is the project root: it disables the directory
# listing and forwards every request into public/.

# Never serve project files directly (safety net when mod_rewrite is off):
# dotfiles (.env, .gitignore, ...) and build/config metadata stay hidden.
<FilesMatch "(^\.|\.(env|json|lock|md|log|sqlite|dist|yml|yaml)$)">
    Require all denied
</FilesMatch>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
